# ============================================================
#  تنظیمات دستیار پشتیبانی هوشمند
#  این فایل را به نام .env کپی کنید و مقادیر را پر کنید.
# ============================================================

# --- کلید AvalAI (اجباری) -----------------------------------
# کلید را از پنل https://avalai.ir بگیرید. با aa- شروع می‌شود.
AVALAI_API_KEY=aa-xxxxxxxxxxxxxxxxxxxxxxxx

# آدرس سرویس (معمولاً نیازی به تغییر ندارد)
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_CREDIT_URL=https://api.avalai.ir/user/v1/credit

# --- مدل‌ها -------------------------------------------------
# مدل اصلی پاسخ‌دهی. گزینه‌های خوب برای فارسی:
#   gemini-2.5-flash        (سریع و ارزان — پیش‌فرض)
#   gemini-2.5-pro          (دقیق‌تر، گران‌تر)
#   gpt-4o-mini             (ارزان)
#   claude-sonnet-4-5       (کیفیت بالا)
# فهرست دقیق مدل‌های فعال حساب شما: python scripts/check_avalai.py
CHAT_MODEL=gemini-2.5-flash

# مدل سبک برای کارهای جانبی (بازسازی متن PDF، بازنویسی لحن)
FAST_MODEL=gemini-2.5-flash

# مدل بردارسازی برای جستجوی معنایی
EMBEDDING_MODEL=text-embedding-3-small

# --- رمزهای ورود (حتماً عوض کنید) ---------------------------
ADMIN_PASSWORD=admin
AGENT_PASSWORD=support
SECRET_KEY=یک-رشته-تصادفی-طولانی-اینجا-بگذارید

# --- برند -------------------------------------------------
BRAND_NAME=میلیونر
BRAND_PRODUCT=نرم‌افزار حسابداری و فروشگاهی میلیونر
ASSISTANT_NAME=میلی
SUPPORT_PHONE=
SUPPORT_HOURS=شنبه تا چهارشنبه، ۹ تا ۱۷

# --- سرور --------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- تنظیمات پیشرفته‌ی جستجو -------------------------------
CHUNK_CHARS=900
CHUNK_OVERLAP=160
TOP_K=8
MAX_UPLOAD_MB=60
