# ============================================================
#  تنظیمات دستیار پشتیبانی هوشمند
#  این فایل را به نام .env کپی کنید و مقادیر را پر کنید.
# ============================================================

# --- کلید AvalAI (اجباری) -----------------------------------
# کلید را از پنل https://avalai.ir بگیرید. با aa- شروع می‌شود.
AVALAI_API_KEY=aa-xxxxxxxxxxxxxxxxxxxxxxxx

# آدرس سرویس (معمولاً نیازی به تغییر ندارد)
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_CREDIT_URL=https://api.avalai.ir/user/v1/credit

# --- مدل‌ها -------------------------------------------------
# ⚠️ نام مدل‌ها مدام عوض می‌شود. به‌جای اعتماد به این فایل، دو دستور زیر را بزنید:
#     python scripts/check_avalai.py                    → مدل‌های فعالِ حساب خودتان
#     python scripts/compare_models.py مدل۱ مدل۲ ...    → مقایسه روی مستندات خودتان
#
# این کار «پاسخ به سوال از روی مستندات» است، نه استدلال سنگین. پس مدل رده‌ی
# سریع (flash / mini / haiku) تقریباً همیشه کافی است؛ مدل گران‌تر معمولاً فقط
# هزینه را بالا می‌برد، نه دقت را. اگر پاسخ‌ها غلط بودند، اول کیفیت مستندات و
# بعد مدل را عوض کنید.
CHAT_MODEL=gemini-3.7-flash

# مدل سبک برای کارهای جانبی (بازسازی متن، بازنویسی لحن برای مشتری).
# می‌تواند از CHAT_MODEL هم ارزان‌تر باشد.
FAST_MODEL=gemini-3.7-flash

# مدل بینایی برای خواندن اسکرین‌شات‌های داخل PDF.
# حتماً باید مدلی باشد که تصویر را می‌فهمد (Gemini، GPT-5.x، Claude).
VISION_MODEL=gemini-3.7-flash

# مدل بردارسازی برای جستجوی معنایی.
# نسخه‌ی large برای فارسی محسوس بهتر است و چون فقط یک‌بار هنگام بارگذاری فایل
# اجرا می‌شود، هزینه‌اش ناچیز است. اگر روی حسابتان فعال نبود، به small برگردید.
EMBEDDING_MODEL=text-embedding-3-large

# --- رمزهای ورود (حتماً عوض کنید) ---------------------------
ADMIN_PASSWORD=admin
AGENT_PASSWORD=support
SECRET_KEY=یک-رشته-تصادفی-طولانی-اینجا-بگذارید

# --- برند -------------------------------------------------
BRAND_NAME=میلیونر
BRAND_PRODUCT=نرم‌افزار حسابداری و فروشگاهی میلیونر
ASSISTANT_NAME=میلی
SUPPORT_PHONE=
SUPPORT_HOURS=شنبه تا چهارشنبه، ۹ تا ۱۷

# --- سرور --------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- تنظیمات پیشرفته‌ی جستجو -------------------------------
CHUNK_CHARS=900
CHUNK_OVERLAP=160
TOP_K=8
MAX_UPLOAD_MB=60

# --- خواندن تصویری صفحه‌های PDF ------------------------------
# صفحه‌هایی که اسکرین‌شات دارند، به تصویر رندر و به VISION_MODEL داده می‌شوند
# تا محتوای پنجره‌ها، دکمه‌ها و پیام‌های خطا هم قابل جستجو شود.
# این کار فقط یک‌بار هنگام بارگذاری فایل انجام می‌شود، نه در هر سوال.
VISION_ENABLED=true

# کیفیت رندر صفحه. ۱۲۰ برای اسکرین‌شات‌های معمولی کافی است؛
# اگر متن داخل تصویرها ریز است ۱۵۰ را امتحان کنید (گران‌تر می‌شود).
VISION_DPI=120

# سقف تعداد صفحه‌ی تصویری در هر فایل — محافظ در برابر خرج ناخواسته
VISION_MAX_PAGES=300
VISION_CONCURRENCY=3
